# =====================================================================
#  Gartic AI Phone — environment configuration
#  Copy this file to .env and fill in your values.
#  .env is git-ignored and never committed.
# =====================================================================

# ── LOCAL DEV (used by the Vite dev-server proxy) ──────────────────
# The key is injected into the Authorization header by vite.config.js
# on the Node side. It never enters the browser bundle.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ECS SERVER (set these on your Alibaba Cloud ECS instance) ──────
# Copy these to /etc/environment or your PM2 ecosystem file on ECS.
# Do NOT put real values in this file.
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # same key, on ECS
# PORT=3000
# CORS_ORIGIN=https://Snowsonata.github.io               # your GitHub Pages origin

# ── GITHUB ACTIONS BUILD ───────────────────────────────────────────
# Set VITE_ECS_PROXY_URL as a GitHub Actions secret:
#   GitHub → repo Settings → Secrets and variables → Actions → New secret
#   Name:  VITE_ECS_PROXY_URL
#   Value: http://<your-ECS-public-IP>:3000
#
# The CI build injects it so the compiled JS calls your ECS proxy
# instead of trying a same-origin relative path.
# Leave unset locally — the Vite dev-server proxy handles /dashscope/*.
# VITE_ECS_PROXY_URL=http://1.2.3.4:3000

# ── FRONTEND MODEL CONFIG (safe to commit if you want) ─────────────
VITE_DASHSCOPE_MODEL=wanx2.1-t2i-turbo
VITE_IMAGE_SIZE=1024*1024
