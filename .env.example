# =====================================================================
#  Gartic AI Phone — environment configuration
#  Copy this file to .env and fill in your values.
# =====================================================================

# ---- DEV MODE (proxy — key stays server-side) -----------------------
# Used by the Vite dev proxy (vite.config.js). No VITE_ prefix so the
# key is never bundled into client-side JS.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- PRODUCTION BUILDS + DIRECT MODE --------------------------------
# Required for `vite build` output. The key is embedded in the client
# bundle — acceptable for a local offline build, but rotate it if you
# ever host this publicly.
VITE_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How the client reaches DashScope in dev: "proxy" (default) or "direct".
VITE_DASHSCOPE_MODE=proxy

# Model to use for image generation.
# Options: wanx2.1-t2i-turbo (fast), wanx2.1-t2i-plus (quality)
VITE_DASHSCOPE_MODEL=wanx2.1-t2i-turbo

# Output image size.
VITE_IMAGE_SIZE=1024*1024
